# Fastlane — build + signature + envoi TestFlight de l'app iOS Konsilys.
# Conçu pour tourner sur un runner GitHub Actions macOS (aucun Mac local requis).
# La signature utilise `match` (certificats/profils stockés chiffrés dans un dépôt
# git privé), pilotée par une clé API App Store Connect.

default_platform(:ios)

APP_ID = ENV["APP_IDENTIFIER"] || "fr.konsilys.app"

platform :ios do
  desc "Build et envoi sur TestFlight"
  lane :beta do
    # 1. Authentification App Store Connect via clé API (p8 en base64 dans les secrets).
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8_BASE64"],
      is_key_content_base64: true,
      in_house: false
    )

    # 2. Récupère (ou crée) certificat de distribution + profil via match.
    match(
      type: "appstore",
      app_identifier: APP_ID,
      readonly: false,
      api_key: api_key,
      git_url: ENV["MATCH_GIT_URL"],
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTH"] # base64("user:token"), dépôt privé
    )

    # 3. Numérotation : numéro de build = numéro du run CI (monotone).
    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    )

    # 4. Compilation de l'archive signée.
    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Konsilys.ipa"
    )

    # 5. Envoi sur TestFlight (revue interne). Passer skip_waiting_for_build_processing
    #    à false pour attendre le traitement Apple.
    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_ID,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
